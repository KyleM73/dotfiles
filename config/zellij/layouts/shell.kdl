// ~/.config/zellij/layouts/shell.kdl
// A single terminal pane (plus tab/status bars), no auto-nvim. This is the
// default layout, so bare `z` opens it; add tabs with Alt+t.
layout {
    pane size=1 borderless=true {
        plugin location="zjtabs"
    }
    pane
    pane size=2 borderless=true {
        plugin location="zellij:status-bar"
    }

    // New tabs (Alt+t, or Ctrl+t then n) keep the tab/status bars, as a plain shell.
    new_tab_template {
        pane size=1 borderless=true {
            plugin location="zjtabs"
        }
        pane
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
