// ~/.config/zellij/layouts/nvim.kdl
// nvim workspace: full-screen nvim editor with a small floating terminal in the
// bottom-right corner. Alt+f shows/hides (and focuses) it, quake-style. To keep
// it visible while you edit, pin it: Ctrl+p then i, or click its pin icon — a
// pinned pane stays on top and ignores Alt+f until unpinned. Move/resize it in
// pane mode (Ctrl+p, then arrows / n / +/-).
//
// Launch with:  zellij --layout nvim   (alias: zjv). Bare `zj` opens the plain
// single-terminal "shell" layout instead; `zjw` is editor-left / terminal-right.
// New tabs (Alt+t) open as a flat shell — see new_tab_template below. Switch
// tabs with Alt+1-9, close with Alt+w (custom keys in config.kdl).
layout {
    tab focus=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="nvim" {
            focus true
        }
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
        // Anchored bottom-right. x + width > 100% on purpose: zellij floors
        // each percentage (can leave a 1-col gap) then clamps the overshoot,
        // so the right edge sits flush at any terminal size.
        floating_panes {
            pane {
                name "terminal"
                x "56%"
                y "73%"
                width "45%"
                height "25%"
            }
        }
    }

    // New tabs are just a flat shell (no editor, no split).
    new_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
