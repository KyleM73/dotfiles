# Machine-local overrides live in $HOME (e.g. ~/.bashrc.local), never here.
# This is a safety net in case a *.local file is created inside the repo.
*.local
dotfiles.bkp/

# macOS Finder metadata
.DS_Store

# Python bytecode: zweb-switcher.py compiles next to itself inside
# config/zellij (~/.config/zellij symlinks into the repo), and .pyc files
# embed absolute home paths — never publish them.
__pycache__/
*.pyc
