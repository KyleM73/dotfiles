# Machine-local overrides live in $HOME (e.g. ~/.bashrc.local), never here.
# This is a safety net in case a *.local file is created inside the repo.
*.local
dotfiles.bkp/

# macOS Finder metadata
.DS_Store

# Python bytecode embeds absolute home paths (config dirs symlink into the
# repo) — never publish it.
__pycache__/
*.pyc
