# Identity and host-specific routing live in untracked ~/.gitconfig.local
# (written by make_symlinks.sh), included at the BOTTOM of this file — git lets
# the last definition win, so machine-local settings override everything here.

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    default = simple
    autoSetupRemote = true   # needs git >= 2.37; older git ignores it

[fetch]
    prune = true

# No core.editor on purpose: git falls back to $VISUAL/$EDITOR, which the shell
# config points at nvim (or vim on machines without it).

[color]
    ui = auto

[alias]
    s = status
    a = add
    aa = add -A
    c = commit -m
    co = checkout
    b = branch
    d = diff
    p = push
    pl = pull
    l = log --oneline --graph --decorate -20

# Machine-local identity + overrides — kept last so its values win (see top).
[include]
    path = ~/.gitconfig.local
