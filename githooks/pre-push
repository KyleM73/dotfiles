#!/bin/sh
# pre-push — refuse to publish likely secrets to the public repo.
# Wired up by make_symlinks.sh via `git config core.hooksPath githooks`.
#
# Scans the ADDED lines of every commit about to be pushed for key material
# and identifiers that must stay private: private-key blocks, cloud/API
# credentials, credential-looking assignments, tailscale identifiers (real
# *.ts.net hostnames, tskey auth keys, CGNAT 100.64/10 addresses), and UUIDs
# (zellij web login tokens are UUIDs). Docs use placeholders like
# <machine>.<tailnet>.ts.net and HOST, which the patterns deliberately miss.
#
# A false positive can be pushed past the guard, after eyeballing the match:
#   ALLOW_SECRETS=1 git push
[ -n "$ALLOW_SECRETS" ] && exit 0

ZERO=0000000000000000000000000000000000000000

# One ERE, built up an alternative at a time (readable, and no leading '-'
# reaches grep as an option). The literal pattern text never matches itself,
# so committing this hook passes its own scan.
PAT='-----BEGIN [A-Z ]*PRIVATE KEY'
PAT="$PAT|AKIA[0-9A-Z]{16}"                                # AWS access key
PAT="$PAT|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}"
PAT="$PAT|xox[baprs]-[A-Za-z0-9-]+"                        # Slack
PAT="$PAT|sk-[A-Za-z0-9_-]{20,}"                           # API keys (sk-...)
# key/secret/password/token assigned a QUOTED literal. Requiring the quote
# keeps real secrets ("hunter2...") in scope while ignoring code that merely
# reads a field (auth_token: document.getElementById(...)).
PAT="$PAT|(api[_-]?key|secret|passwd|password|token)[\"']? *[:=] *[\"'][A-Za-z0-9_/+.-]{8,}"
PAT="$PAT|[a-z0-9-]+\.[a-z0-9-]+\.ts\.net"                 # real tailnet hosts
PAT="$PAT|tskey-[a-z0-9-]{6,}"                             # tailscale auth keys
PAT="$PAT|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}"  # CGNAT IPs
PAT="$PAT|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"         # UUIDs

status=0
while read -r _lref lsha _rref rsha; do
    [ "$lsha" = "$ZERO" ] && continue                   # deleting a remote ref
    if [ "$rsha" = "$ZERO" ]; then
        # New ref: scan only commits not already on some remote.
        added="$(git log -p --format= "$lsha" --not --remotes 2>/dev/null)"
    else
        added="$(git log -p --format= "$rsha..$lsha" 2>/dev/null)"
    fi
    hits="$(printf '%s\n' "$added" | grep '^+' | grep -v '^+++ ' | grep -iEn -e "$PAT")"
    rc=$?
    if [ "$rc" -ge 2 ]; then
        # grep itself failed — never mistake a broken scan for a clean one.
        echo "pre-push: secret scan errored (grep exit $rc) — blocking to be safe" >&2
        status=1
    elif [ -n "$hits" ]; then
        echo "pre-push: possible secret in commits for $_rref — push blocked:" >&2
        printf '%s\n' "$hits" | head -20 >&2
        echo "pre-push: if these are all false positives: ALLOW_SECRETS=1 git push" >&2
        status=1
    fi
done
exit $status
