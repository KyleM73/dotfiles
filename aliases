# Common Aliases
# GNU ls uses --color=auto; BSD ls (stock macOS) uses -G. Probe on a fixed path
# (-d /) so it's constant-time and immune to an unreadable/huge current dir.
if ls --color=auto -d / >/dev/null 2>&1; then
    alias ls='ls --color=auto'
else
    alias ls='ls -G'
fi
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'
alias grep='grep --color=auto'
alias df='df -h'
alias du='du -h'
alias c='clear'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'

# Git Aliases
alias gs='git status'
alias ga='git add'
alias gaa='git add -A'
alias gc='git commit -m'
alias gp='git push'
alias gl='git pull'
alias gco='git checkout'
alias gb='git branch'
alias gd='git diff'

# Docker Aliases (the -a suffix means ALL: drma/drmia wipe every container/image)
alias dps='docker ps'
alias dpsa='docker ps -a'
alias drm='docker rm'
alias drma='docker rm $(docker ps -a -q)'
alias dimg='docker images'
alias drmi='docker rmi'
alias drmia='docker rmi $(docker images -q)'
alias dstart='docker start'
alias dstop='docker stop'
alias dexec='docker exec -it'

# Docker Compose Aliases
alias dcu='docker compose up'
alias dcd='docker compose down'
alias dcb='docker compose build'
alias dcr='docker compose run --rm'
alias dclean='docker compose down --remove-orphans --volumes'

# Conda Aliases
alias ca='conda activate'
alias cdd='conda deactivate'
# cdda pops the whole env stack; break if deactivate fails OR makes no progress
# (conda no-ops with exit 0 when its stack is empty but CONDA_PREFIX leaked in).
alias cdda='while [ -n "$CONDA_PREFIX" ]; do __cp="$CONDA_PREFIX"; conda deactivate || break; [ "$CONDA_PREFIX" = "$__cp" ] && break; done; unset __cp'

# RC Aliases — edit() uses $EDITOR; vimrc/nvimrc stay editor-specific.
# (eval, because zsh doesn't word-split a multi-word EDITOR like "code -w")
edit() { eval "${EDITOR:-vim} \"\$@\""; }
alias src='if [ -n "$ZSH_VERSION" ]; then source ~/.zshrc; else source ~/.bashrc; fi'
alias shellrc='if [ -n "$ZSH_VERSION" ]; then edit ~/.zshrc; else edit ~/.bashrc; fi'
alias bashrc='edit ~/.bashrc'
alias zshrc='edit ~/.zshrc'
alias vimrc='vim ~/.vimrc'
alias nvimrc='nvim ~/.config/nvim/init.lua'
alias screenrc='edit ~/.screenrc'
alias gitconfig='edit ~/.gitconfig'
alias zellijrc='edit ~/.config/zellij/config.kdl'
alias yazirc='edit ~/.config/yazi/yazi.toml'

# Neovim / multiplexer shortcuts
alias v='nvim'
alias zj='zellij'                  # default layout: full-screen nvim + floating terminal (Alt+f)
alias zjw='zellij --layout wide'   # editor left / terminal right
alias zjs='zellij --layout shell'  # plain shell session (no auto-nvim)

# zssh HOST [SESSION]: SSH in and attach-or-create ONE persistent zellij session
# (default "main"), so nvim + a claude session + a shell live as tabs in a single
# connection — after a drop, `zssh HOST` brings the whole workspace back. -t forces
# a TTY. Pass a second arg for another workspace on the same host.
zssh() {
    [ -z "$1" ] && { echo "usage: zssh HOST [SESSION]" >&2; return 2; }
    ssh -t "$1" "zellij attach -c '${2:-main}'"
}

# venv
alias venv="source .venv/bin/activate"
