# Conda Aliases
alias ca='conda activate'
alias cdd='conda deactivate'
# cdda pops the whole env stack; break if deactivate fails OR makes no progress
# (conda no-ops with exit 0 when its stack is empty but CONDA_PREFIX leaked in).
alias cdda='while [ -n "$CONDA_PREFIX" ]; do __cp="$CONDA_PREFIX"; conda deactivate || break; [ "$CONDA_PREFIX" = "$__cp" ] && break; done; unset __cp'

# RC Aliases — edit() uses $EDITOR; vimrc/nvimrc stay editor-specific.
# (eval, because zsh doesn't word-split a multi-word EDITOR like "code -w")
edit() { eval "${EDITOR:-vim} \"\$@\""; }
alias src='if [ -n "$ZSH_VERSION" ]; then source ~/.zshrc; else source ~/.bashrc; fi'
alias shellrc='if [ -n "$ZSH_VERSION" ]; then edit ~/.zshrc; else edit ~/.bashrc; fi'
alias bashrc='edit ~/.bashrc'
alias zshrc='edit ~/.zshrc'
alias vimrc='vim ~/.vimrc'
alias nvimrc='nvim ~/.config/nvim/init.lua'
alias screenrc='edit ~/.screenrc'
alias gitconfig='edit ~/.gitconfig'
alias zellijrc='edit ~/.config/zellij/config.kdl'
alias yazirc='edit ~/.config/yazi/yazi.toml'

# Neovim / multiplexer shortcuts
alias v='nvim'
# zj [LAYOUT]: attach to (or create) a zellij session named after the current
# directory's basename, so re-running in a project reattaches its session instead
# of spawning a new random-named one. LAYOUT applies only on create; zjv/zjw pass
# it. zj = single terminal (default), zjv = nvim + float, zjw = editor | terminal.
# For a custom-named session use `zellij -s NAME` directly.
zj() {
    local name="${PWD##*/}"
    name="${name//[^A-Za-z0-9_-]/-}"; [ -z "$name" ] && name="zj"
    if zellij list-sessions -ns 2>/dev/null | grep -qx "$name"; then
        zellij attach "$name"
    elif [ -n "$1" ]; then
        zellij --session "$name" --layout "$1"
    else
        zellij --session "$name"
    fi
}
alias zjv='zj nvim'   # full-screen nvim + floating terminal (Alt+f)
alias zjw='zj wide'   # editor left / terminal right

# Session management. With session_serialization on, `kill` leaves a session
# resurrectable (still listed); `delete` removes it for good.
alias zjls='zellij list-sessions'      # running + resurrectable sessions
alias zja='zellij attach'              # zja NAME  (add -c to create)
alias zjk='zellij kill-session'        # stop one (stays resurrectable)
alias zjka='zellij kill-all-sessions'
alias zjd='zellij delete-session'      # remove one for good (also clears a killed session)
alias zjda='zellij delete-all-sessions'

# zssh HOST [SESSION]: SSH in and attach-or-create ONE persistent zellij session
# (default "main") so your work survives drops — reconnect with the same command.
# -t forces a TTY; a second arg names a separate workspace on the same host.
zssh() {
    [ -z "$1" ] && { echo "usage: zssh HOST [SESSION]" >&2; return 2; }
    ssh -t "$1" "zellij attach -c '${2:-main}'"
}

