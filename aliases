# Conda Aliases
alias ca='conda activate'
alias cdd='conda deactivate'
# cdda pops the whole env stack; break if deactivate fails OR makes no progress
# (conda no-ops with exit 0 when its stack is empty but CONDA_PREFIX leaked in).
alias cdda='while [ -n "$CONDA_PREFIX" ]; do __cp="$CONDA_PREFIX"; conda deactivate || break; [ "$CONDA_PREFIX" = "$__cp" ] && break; done; unset __cp'

# RC Aliases — edit() uses $EDITOR; vimrc/nvimrc stay editor-specific.
# (eval, because zsh doesn't word-split a multi-word EDITOR like "code -w")
edit() { eval "${EDITOR:-vim} \"\$@\""; }
alias src='if [ -n "$ZSH_VERSION" ]; then source ~/.zshrc; else source ~/.bashrc; fi'
alias shellrc='if [ -n "$ZSH_VERSION" ]; then edit ~/.zshrc; else edit ~/.bashrc; fi'
alias bashrc='edit ~/.bashrc'
alias zshrc='edit ~/.zshrc'
alias vimrc='vim ~/.vimrc'
alias nvimrc='nvim ~/.config/nvim/init.lua'
alias screenrc='edit ~/.screenrc'
alias gitconfig='edit ~/.gitconfig'
alias zellijrc='edit ~/.config/zellij/config.kdl'
alias yazirc='edit ~/.config/yazi/yazi.toml'

