# (conda no-ops with exit 0 when its stack is empty but CONDA_PREFIX leaked in).
alias cdda='while [ -n "$CONDA_PREFIX" ]; do __cp="$CONDA_PREFIX"; conda deactivate || break; [ "$CONDA_PREFIX" = "$__cp" ] && break; done; unset __cp'

