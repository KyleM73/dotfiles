# Common Aliases
# GNU ls uses --color=auto; BSD ls (stock macOS) uses -G. Probe on a fixed path
# (-d /) so it's constant-time and immune to an unreadable/huge current dir.
if ls --color=auto -d / >/dev/null 2>&1; then
    alias ls='ls --color=auto'
else
    alias ls='ls -G'
fi
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'
alias grep='grep --color=auto'
alias df='df -h'
alias du='du -h'
alias c='clear'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'

