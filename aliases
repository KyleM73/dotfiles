# z [DIR]: attach to (or create) a zellij session named after DIR's basename
# (default: cwd), with panes starting in DIR — so re-running in a project reattaches
# it. zv/zw/zm use the nvim / wide / mobile layout. Tab-completes directories (`z files` ->
# `~/projects/dotfiles`; see bashrc). zoxide's jump lives on `zz`/`zzi`.
_zsession() {   # _zsession LAYOUT [DIR] [SUFFIX]
    local layout="$1" dir="${2:-$PWD}" suffix="$3" name r rest
    case "$2" in -h|--help) cat <<'EOF'
usage: z|zv|zw|zm [DIR]
  Attach to (or create) the zellij session named after DIR's basename
  (default: the current dir). DIR tab-completes; a non-directory argument
  fuzzy-matches via zoxide (z files -> ~/projects/dotfiles).
  z   single terminal pane        (layout: shell)
  zv  nvim + floating terminal    (layout: nvim)
  zw  editor left, terminal right (layout: wide)
  zm  mobile-sized, session named "<dir>-mobile" (layout: mobile)
EOF
    return 0 ;; esac
    dir="${dir%/}"; [ -z "$dir" ] && dir=/                    # tolerate a trailing slash from completion
    rest="${dir#\~}"; [ "$rest" != "$dir" ] && dir="$HOME$rest"   # expand a leading ~ (escaped by completion)
    if [ -n "$2" ] && [ ! -d "$dir" ]; then                   # not a dir -> fuzzy-resolve via zoxide
        r="$(zoxide query -- "$dir" 2>/dev/null)"
        if [ -n "$r" ] && [ -d "$r" ]; then dir="$r"
        else echo "z: no directory or zoxide match: $2" >&2; return 1; fi
    fi
    dir="$(cd -- "$dir" 2>/dev/null && pwd)" || { echo "z: cannot cd to $dir" >&2; return 1; }  # resolve . / .. / relative so the name is the real basename
    name="${dir##*/}"; name="${name//[^A-Za-z0-9_-]/-}"
    while [ "${name#-}" != "$name" ]; do name="${name#-}"; done  # no leading '-': zellij would parse the name as a flag
    [ -z "$name" ] && name="z"
    name="$name$suffix"
    # One race-free call: attach if the session exists (running, or exited ->
    # resurrect), else create it with LAYOUT in DIR. (A check-then-act split
    # here can lose the race against web clients, which create and drop
    # sessions on their own as browser tabs come and go.)
    if [ -n "$layout" ]; then
        ( cd "$dir" && zellij --layout "$layout" attach --create "$name" )
    else
        ( cd "$dir" && zellij attach --create "$name" )
    fi
}
z()  { _zsession ''   "$1"; }   # z [dir]:  single terminal
zv() { _zsession nvim "$1"; }   # zv [dir]: full-screen nvim + floating terminal (Alt+f)
zw() { _zsession wide "$1"; }   # zw [dir]: editor left / terminal right
# zm gets its own "<dir>-mobile" session: a layout (and its new_tab_template)
# is baked in at session creation, so reusing the plain dir name would turn
# your regular session into a mobile-formatted one — and a mobile client
# attaching to the desktop session would shrink it (zellij sizes to the
# smallest client).
zm() { _zsession mobile "$1" "-mobile"; }  # zm [dir]: mobile-sized (1-line dir bar, no status bar)

# ztab: re-sync every zellij tab's name to its focused pane's path (shell -> dir,
# nvim -> dir/filename). New tabs are named once on creation (see bashrc); run
# this to refresh after cd-ing around. A tab you rename yourself stays put.
ztab() { "$HOME/.config/zellij/ztab.sh" "$@"; }

# Session management. With session_serialization on, `kill` leaves a session
# resurrectable (still listed); `delete` removes it for good. za/zk/zd are
# functions (not aliases) so zsh honors their session-name completion (see bashrc).
alias zls='zellij list-sessions'        # running + resurrectable sessions
alias zka='zellij kill-all-sessions'
alias zda='zellij delete-all-sessions'
za() { zellij attach "$@"; }            # za NAME   (add -c to create)
zk() { zellij kill-session "$@"; }      # zk NAME   (stays resurrectable)
zd() { zellij delete-session "$@"; }    # zd NAME   (gone for good)

# Single-quote a value for safe embedding in a remote ssh command string.
_shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# zssh / mssh HOST [DIR|query]: connect and reattach a persistent zellij session
# on HOST, named by directory basename (like `z`). No query reopens HOST's most
# recent session (or creates one in your login dir); a query fuzzy-matches HOST's
# sessions (fzf picker if several), else cd's into it as a dir and starts one.
# zssh uses SSH; mssh uses mosh — resilient UDP + local echo for spotty/roaming
# wifi (needs mosh + UDP 60000-61000 on HOST; no in-session agent forwarding).
_zconnect() {   # _zconnect TRANSPORT HOST REMOTE_SH — run REMOTE_SH interactively
    case "$1" in
        mosh) echo "mssh: if this hangs at 'Connecting...', UDP 60000-61000 is likely blocked -> Ctrl-C and use: zssh $2" >&2
              mosh "$2" -- sh -c "$3" ;;
        *)    ssh -t "$2" "$3" ;;
    esac
}
_zssh_impl() {  # _zssh_impl TRANSPORT HOST [DIR|query]
    local xport="$1" host="$2" query="$3" name names qbase target rc fzrc
    name=zssh; [ "$xport" = mosh ] && name=mssh
    case "$host" in ''|-h|--help)
        echo "usage: $name HOST [DIR|query] — reattach HOST's most recent zellij session; a query fuzzy-matches its sessions, a dir starts one there"
        [ -n "$host" ] && return 0 || return 2 ;;
    esac

    if [ -z "$query" ]; then
        # Reopen the most recent session (newest = last line); else create one in
        # the login dir. (list-fetch uses SSH even for mssh — a quick one-shot.)
        _zconnect "$xport" "$host" '
            s=$(zellij list-sessions -ns 2>/dev/null | tail -n1)
            [ -n "$s" ] && exec zellij attach "$s"
            exec zellij -s "$(basename "$PWD")"'
        rc=$?
        [ "$rc" -eq 255 ] && echo "$name: cannot reach '$host' (host unreachable)" >&2
        return "$rc"
    fi

    names="$(ssh "$host" 'zellij list-sessions -ns 2>/dev/null')"; rc=$?
    [ "$rc" -eq 255 ] && { echo "$name: cannot reach '$host' (host unreachable)" >&2; return 1; }
    qbase="$(basename -- "$query")"

    if printf '%s\n' "$names" | grep -Fqx -- "$qbase"; then
        target="$qbase"                                     # exact match wins
    elif command -v fzf >/dev/null 2>&1; then
        target="$(printf '%s\n' "$names" | sed '/^$/d' | \
                  fzf -1 -0 --query="$qbase" --prompt="$host session> ")"; fzrc=$?
        [ "${fzrc:-0}" -eq 130 ] && return 130              # picker cancelled
    else
        target="$(printf '%s\n' "$names" | grep -iF -- "$qbase" | head -n1)"
    fi

    if [ -n "$target" ]; then
        _zconnect "$xport" "$host" "exec zellij attach $(_shq "$target")"
    else
        # No session matched: the query is a directory — start zellij there.
        _zconnect "$xport" "$host" "cd -- $(_shq "$query") && exec zellij -s $(_shq "$qbase")"
    fi
}
zssh() { _zssh_impl ssh "$@"; }
mssh() { command -v mosh >/dev/null 2>&1 || { echo "mssh: mosh not installed (run install_deps.sh)" >&2; return 1; }; _zssh_impl mosh "$@"; }

# zweb: zellij web access on the tailnet — tokens, publish (`zweb up`), login
# autostart. Implementation + docs: config/zellij/zweb.sh
zweb() { "$HOME/.config/zellij/zweb.sh" "$@"; }

# glow 2.x word-wraps at ~80 columns no matter how narrow the terminal is,
# so on a mobile-width pane every line hard-wraps mid-word. Wrap at the real pane width instead, keeping 80 as the
# cap so wide panes read like glow's default. Note: like any terminal output,
# an already-rendered doc doesn't re-wrap when the pane later changes width
# (rotation, a different-sized client attaching) — re-run glow after.
glow() {
    # stty reads the terminal via stdin, which command substitution keeps —
    # tput cols would probe stdout, a pipe inside $(), and silently report 80.
    local w; w="$(stty size 2>/dev/null | awk '{print $2}')"
    [ -n "$w" ] || w="${COLUMNS:-80}"
    # glow pads a few chars past the wrap width, so leave headroom on narrow
    # panes; wide panes cap at glow's classic 80.
    if [ "$w" -gt 80 ]; then w=80; elif [ "$w" -gt 12 ]; then w=$((w - 4)); fi
    command glow -w "$w" "$@"
}

